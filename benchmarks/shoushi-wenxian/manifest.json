{
  "detectorSchema": {
    "description": "detectors 记录外部检测器的实测结果。只记录真实测过的数据，没测过就留空数组。humanPct / suspectedPct / aiPct 为朱雀报告里三种特征的字数占比，aigc 为片段 AIGC 值（0-1）。scope=excerpt 表示检测对象是全章、而本文件只是节选。",
    "fields": [
      "name",
      "testedAt",
      "scope",
      "humanPct",
      "suspectedPct",
      "aiPct",
      "aigc",
      "segments",
      "source",
      "note"
    ]
  },
  "generationSchema": {
    "description": "generation 记录这一版正文由谁、用哪个版本的 skill 生成。model 写模型名，modelVersion 写模型的具体版本或日期（平台显示什么就记什么），skillVersion 写当时用的 InkBone 版本，source 写信息来源。不知道的字段填 null，不要猜。比较不同模型时，只比 skillVersion 相同的条目；比较不同 skill 版本时，只比 model 相同的条目。",
    "fields": [
      "model",
      "modelVersion",
      "skillVersion",
      "source"
    ]
  },
