{
  "name": "inkbone",
  "version": "2.0.0",
  "description": "Zero-dependency Chinese long-form fiction engineering suite: Agent Skill, full MCP server (tools/prompts/resources), living ledger, copyright-safe style profiler, platform exporter, Traditional Chinese support, Browser Doctor & VS Code linter.",
  "type": "module",
  "bin": {
    "inkbone": "./bin/inkbone.mjs"
  },
  "files": [
    "bin",
    "src",
    "configs",
    "prompts",
    "resources",
    "examples",
    "skills/inkbone"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./profiler": "./src/profiler.mjs",
    "./auditor": "./src/auditor.mjs",
    "./boundary": "./src/boundary-compiler.mjs",
    "./evidence": "./src/evidence-validator.mjs",
    "./doctor": "./src/doctor.mjs",
    "./ledger": "./src/ledger-manager.mjs",
    "./formatter": "./src/formatter.mjs",
    "./mcp": "./src/mcp-server.mjs",
    "./style": "./src/style-profiler.mjs",
    "./exporter": "./src/exporter.mjs",
    "./browser-doctor": "./src/browser-doctor.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node ./bin/inkbone.mjs benchmark",
    "build:skill": "node scripts/build-skill.mjs",
    "check:skill": "node scripts/build-skill.mjs --check",
    "build:docs": "node scripts/build-docs.mjs",
    "check:docs": "node scripts/build-docs.mjs --check",
    "export:public": "node scripts/export-public.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chinese-novel",
    "multi-genre",
    "register-consistency",
    "computational-linguistics",
    "writing-engine",
    "agent-skill"
  ],
  "author": "blankym",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blankym/inkbone.git"
  },
  "bugs": "https://github.com/blankym/inkbone/issues",
  "homepage": "https://github.com/blankym/inkbone#readme",
  "publishConfig": {
    "access": "public"
  }
}
