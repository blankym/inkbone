        "时候",
        "现在",
        "因为",
        "所以",
        "但是",
        "不过",
        "然后",
        "已经",
        "还是",
        "起来",
        "出来",
        "下去"
      ],
      "plainTerms": [
        "的",
        "了",
        "就",
        "也",
        "还",
        "又",
        "这个",
        "那个",
        "东西",
        "事情",
