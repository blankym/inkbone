      "minChars": 800,
      "maxFunctionPerKilo": 100,
      "maxPlainPerKilo": 65,
      "longSentChars": 30,
      "maxLongSentRatio": 0.08,
      "review": "semantic",
      "remedy": "Telegraphic prose alert: narrative outside quotes lacks natural vernacular connectors and medium-long clauses."
    },
    "dialogueOnlyStreakTic": {
      "id": "tic_dialogue_only_streak",
      "quoteLinePattern": "^\\s*(?:[“「『][^”」』]+[”」』]\\s*)+$",
      "minStreak": 8,
      "review": "semantic",
      "remedy": "Break 8+ consecutive unanchored quote-only paragraphs with concrete speaker actions or scene beats."
    }
  },
  "degeneration": {
    "adjacentRepeatMinLen": 8,
    "sentenceRepeatMinLen": 12,
    "sentenceRepeatMinCount": 3,
    "sentenceSplitRegex": "[。！？!?]+",
    "chapterHeadingRegex": "^第[零〇一二三四五六七八九十百千万两0-9]+[章节回](?:$|[\\s_：:——\\-]+[^\\n。；;]{0,28}$)",
    "endSignoffRegex": "^[-—~～＜<【\\[（(《\\s]*(?:全文完|正文完|全书完|本卷完|完结|完|END|The\\s+End)[-—~～＞>】\\]）)》.。！!\\s]*$",
    "dividerRegex": "^(?:-{3,}|[*_]{3,})$",
    "trailingMarkdownStripRegex": "[*_~`\\s]+$",
    "terminalPunctuationRegex": "[。！？!?….”」』\"')\\]】）>》~—]$",
    "placeholderRules": [
      {
        "id": "degen_ai_self_ref",
        "scope": "narration",
        "pattern": "作为(?:一个)?(?:AI|人工智能|大?语言模型|智能助手|聊天助手)(?:语言模型|大?模型|助手|机器人)?(?=[，,。、；;：:！!？?\\s）)」』\"】]|我|无法|不能|没法|$)",
        "remedy": "Remove leaked AI self-reference."
      },
      {
        "id": "degen_replacement_char",
        "scope": "all",
        "pattern": "\\uFFFD",
        "remedy": "Fix garbled Unicode replacement character."
      },
      {
        "id": "degen_english_refusal",
        "scope": "all",
        "pattern": "^(?:Sure|Certainly|Here'?s|As an AI|I (?:cannot|can't|am unable|apologize))",
        "remedy": "Remove English assistant preamble/refusal leaked into prose."
      },
      {
        "id": "degen_bracket_omission",
        "scope": "all",
        "pattern": "[（(](?:此处|以下|这里|下文|后续)?\\s*(?:省略|略)(?:去|过)?[^）)]{0,10}[）)]",
        "remedy": "Replace omitted placeholder brackets with actual prose."
      },
      {
        "id": "degen_placeholder_word",
        "scope": "all",
        "pattern": "未完待续|TODO|占位符|placeholder",
        "remedy": "Remove unfinished draft placeholder."
      },
      {
        "id": "degen_refusal_zh",
        "scope": "narration",
        "pattern": "我(?:无法|不能)(?:继续(?:写|创作|生成|下去)|生成(?:内容|文本|正文)?|创作|续写|完成(?:这个|本)?(?:章|篇|创作|请求))",
        "remedy": "Remove model refusal leaked into prose."
      }
    ],
    "metaLeakTier1Pattern": "细纲|(?<!剧)情节点|卷纲|功能标签|目标情绪|字数目标|字数口径|章首钩子|章尾钩子|这章不能说破|本章禁止提前释放|排纲笔记|排纲底稿|节尾停在哪|结尾承接",
    "metaLeakTier2Pattern": "第[零〇一二三四五六七八九十百千万两0-9]+章|本章|这一章|上一章|下一章|上章|下章|前一章|后一章|前文|后文|伏笔|读者|任务描述"
